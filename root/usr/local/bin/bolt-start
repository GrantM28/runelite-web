#!/bin/bash
# Launch Bolt. Data lives under $HOME (/config) so logins and settings persist.
export HOME="${HOME:-/config}"
[ "$HOME" = "/" ] && export HOME=/config
# Selkies injects input/udev shims via LD_PRELOAD; they crash Bolt (CEF) with SIGILL.
unset LD_PRELOAD
export DISPLAY="${DISPLAY:-:1}"
export JAVA_HOME="${JAVA_HOME:-/opt/java}"
export PATH="$JAVA_HOME/bin:$PATH"
log="$HOME/logs/bolt.log"
mkdir -p "$HOME/.local/share" "$HOME/.config" "$HOME/logs"
# Chromium's profile lock records the container hostname, which changes every time
# the container is recreated (e.g. image updates). Clear a stale lock if Bolt isn't running.
if ! pgrep -f /opt/bolt/ >/dev/null; then
  rm -f "$HOME"/.local/share/bolt-launcher/CefCache/Singleton{Lock,Socket,Cookie}
fi
# Containers usually have no usable GPU: force Chromium's software rendering
# unless BOLT_GPU=true. BOLT_ARGS adds extra flags.
args=()
if [ "${BOLT_GPU,,}" != "true" ]; then
  args+=(--disable-gpu --disable-gpu-compositing --disable-gpu-rasterization)
fi
echo "[$(date)] starting Bolt (user=$(id -un) HOME=$HOME DISPLAY=$DISPLAY args=${args[*]} ${BOLT_ARGS})" >>"$log"
bolt "${args[@]}" ${BOLT_ARGS} 2>&1 | grep --line-buffered -v "dbus/" >>"$log"
echo "[$(date)] Bolt exited with code ${PIPESTATUS[0]}" >>"$log"
